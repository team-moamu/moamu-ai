AI_PROVIDER=gemini
AI_IMAGE_SOURCE=s3
AI_MODEL_VERSION=photo-verifier-v1
AI_IMAGE_ROOT=./data/images
AI_PROMPT_VERSION=photo-verification-v4
GEMINI_TOKEN_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set low for a controlled Gemini model comparison; omit to use each model's default.
# GEMINI_THINKING_LEVEL=low
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b
AI_PROVIDER_TIMEOUT_SECONDS=45
# AWS standard names; legacy S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_SESSION_TOKEN also work.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only when using temporary AWS credentials.
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2
S3_BUCKET=
